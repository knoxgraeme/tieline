# ----------------------------------------------------------------------------
# Tieline — environment configuration
# Copy to `.env` and fill in. `.env` is read by migrate/ingest + stdio dev runs.
# On a remote host, set these as platform env vars instead.
# ----------------------------------------------------------------------------

# --- Database (any Postgres + pgvector) -------------------------------------
# A standard Postgres CONNECTION STRING. Works with a local Docker container
# (see docker-compose.yml), Neon, RDS, Supabase, Crunchy, Timescale — anything
# with the pgvector extension available.
#
#   Local docker compose:  postgresql://postgres:postgres@localhost:5432/knowledge
#   Supabase (pooler):     postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Recommended: a READ-ONLY role for the running server (see README).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge

# Migrate and occasional bulk imports need explicit DDL/write privileges. There
# is deliberately no fallback to DATABASE_URL.
DATABASE_URL_INGEST=postgresql://postgres:postgres@localhost:5432/knowledge

# The WRITE tools (create/update stories, feature requests) connect as the
# least-privilege `mcp_writer` role from migration 0009 — NOT the owner. This is
# Production-sensitive mutations become proposals by default. If unset, write
# tools refuse to run; reads are unaffected.
# DATABASE_URL_WRITE=postgresql://mcp_writer:<pw>@localhost:5432/knowledge

# Dedicated human-decision credential. It can execute only approval/rejection
# functions and is never used by ordinary MCP writes.
# DATABASE_URL_APPROVAL=postgresql://mcp_approver:<pw>@localhost:5432/knowledge

# production (default): production creates/updates/relationships need approval.
# all: every story mutation needs approval. off: auto-approve through the
# separate DATABASE_URL_APPROVAL credential (explicit operator choice).
STORY_APPROVAL_MODE=production

# --- Transport ---------------------------------------------------------------
# "stdio" for local dev / Claude Desktop / MCP Inspector (default).
# "http" for the remote streamable-HTTP server (auth is terminated by a gateway
# in front of this server — do not expose /mcp to the public internet directly).
TRANSPORT=stdio
PORT=3000
# HTTP binds to loopback by default. A non-loopback host additionally requires
# HTTP_TRUST_PROXY=true and at least one comma-separated allowed browser Origin.
HTTP_HOST=127.0.0.1
# HTTP_ALLOWED_ORIGINS=https://mcp.example.com
# HTTP_TRUST_PROXY=true

# --- MCP App (interactive review UI) -----------------------------------------
# Opt-in: register the review_stories tool + a ui:// resource so the story-review
# UI renders inside MCP-Apps hosts (Claude, ChatGPT, VS Code, Goose), with
# "Add approved" calling import_stories back through the host. Off by default so
# the base tool surface is unchanged for hosts without MCP-Apps support.
# Requires building the app UI once: `npm run build:app` (needs devDeps/esbuild).
# The core `npm run build` is just `tsc` and never needs esbuild.
# ENABLE_REVIEW_APP=true

# Occasional elevated bulk import is a CLI operation by default. Expose its MCP
# tool only on a deliberately privileged local/gateway instance.
# ENABLE_IMPORT_TOOL=true

# Opt-in: register the explore_graph tool + a ui:// resource that renders the
# whole-corpus section-COUPLING MAP (sections as nodes sized by story count and
# colored by status; edges = shared code-paths/entity-slugs weighted by 1/df, the
# same signal find_crossover ranks). READ-ONLY — unlike the review app it never
# writes, so it's safe to turn on for the hosted retrieval-only deploy. Same
# MCP-Apps host support (Claude, ChatGPT, VS Code, Goose — not Claude Code).
# Also needs the app UI built once: `npm run build:app`.
# ENABLE_GRAPH_APP=true

# --- Embeddings --------------------------------------------------------------
# Selectable text->vector backend. The SAME provider must be used for ingest and
# the server so stored and query vectors share one space. Storage is fixed at
# vector(384); changing width requires a schema migration and full re-embed.
#
#   local         : gte-small IN-PROCESS via @huggingface/transformers. Default.
#                   No external service, no API key, 384-dim. NOT bundled (it pulls
#                   ~400MB of native ONNX runtime, kept out of the base install so
#                   images stay lean): opt in with
#                     npm install @huggingface/transformers
#                   The model itself downloads on first use. For a lean remote
#                   deploy, prefer EMBEDDING_PROVIDER=openai / supabase-edge.
#   openai        : any OpenAI-compatible /embeddings endpoint (OpenAI, Ollama,
#                   LM Studio, HF TEI). It must return 384 dimensions.
#   supabase-edge : a Supabase generate-embedding edge function (back-compat).
#   hash          : deterministic offline hashing — DEV/TESTS ONLY.
#
# Default when EMBEDDING_PROVIDER is unset: `supabase-edge` IF both SUPABASE_URL
# and SUPABASE_ANON_KEY are set (back-compat for existing Supabase deployments),
# otherwise `local`. An explicit value here always wins.
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=Xenova/gte-small            # local default
# EMBEDDING_MODEL=text-embedding-3-small      # openai default, requested at 384

# openai provider only:
# EMBEDDING_BASE_URL=https://api.openai.com/v1   # or http://localhost:11434/v1 (Ollama)
# EMBEDDING_API_KEY=sk-...
# Send the fixed `dimensions: 384` request field by default. Disable only for a
# compatible endpoint that rejects the field but already returns 384 values.
# EMBEDDING_REQUEST_DIMENSIONS=false

# supabase-edge provider only:
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon-public-key>

# --- Code-asset repo name ----------------------------------------------------
# Explicit repository identity for standalone writes outside a Tieline workspace.
# Tieline-managed imports take the stable identity from `.tieline/config.json` and
# reject a conflicting REPO_NAME, so normal `tieline init` users do not set this.
# REPO_NAME=my-repo

# --- Retrieval tuning (override the defaults in src/config.ts) ---------------
# Candidate pool pulled by the KNN gate before overlap fusion.
CANDIDATE_POOL_SIZE=50
# Independent relevance qualification: semantic similarity or exact structural
# overlap can qualify a candidate; below both -> intentional empty result.
FIND_RELATED_MIN_VECTOR_SCORE=0.8
FIND_RELATED_MIN_STRUCTURAL_SCORE=0.01
HELP_CANDIDATE_POOL_SIZE=50
HELP_MIN_SCORE=0.8
