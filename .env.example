# Least-privilege database boundaries
DATABASE_URL=postgresql://tieline_reader:<password>@localhost:5432/tieline
DATABASE_URL_WRITE=postgresql://tieline_planning_writer:<password>@localhost:5432/tieline
DATABASE_URL_SYNC=postgresql://tieline_repository_sync:<password>@localhost:5432/tieline
DATABASE_URL_ADMIN=postgresql://postgres:<password>@localhost:5432/tieline

# local (default), openai, supabase-edge, or hash (development/tests only)
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=Xenova/gte-small
# TIELINE_LOCAL_EMBEDDER_ROOT=/private/runtime/path

# OpenAI-compatible endpoint
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_REQUEST_DIMENSIONS=true

# Supabase Edge embedding provider
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# stdio (default) or http
TRANSPORT=stdio
PORT=3000
HTTP_HOST=127.0.0.1
# Non-loopback HTTP requires both settings and an authenticated TLS gateway.
# HTTP_TRUST_PROXY=true
# HTTP_ALLOWED_ORIGINS=https://your-mcp-host.example

CHARACTER_LIMIT=25000
