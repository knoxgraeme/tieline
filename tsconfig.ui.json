{
  "//": "Type-checks the browser-side MCP-app UIs (src/authoring/review-ui + graph-ui) against the DOM lib. esbuild does the actual transpile/bundle; this is `tsc --noEmit` for safety. Run: npm run typecheck:ui.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/authoring/review-ui/**/*.ts", "src/authoring/graph-ui/**/*.ts"]
}
