{
  "name": "tieline",
  "version": "0.1.0",
  "description": "Local-first user-story mapping CLI and MCP server for connecting product context, lifecycle history, code, and knowledge-base articles.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knoxgraeme/tieline.git"
  },
  "homepage": "https://github.com/knoxgraeme/tieline#readme",
  "bugs": {
    "url": "https://github.com/knoxgraeme/tieline/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tieline": "dist/cli.js"
  },
  "files": [
    "dist",
    "migrations",
    "skills",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "node scripts/build-app-ui.mjs",
    "build:app": "node scripts/build-app-ui.mjs",
    "typecheck:ui": "tsc -p tsconfig.ui.json",
    "clean": "rm -rf dist",
    "tieline": "node dist/cli.js",
    "start": "node dist/cli.js serve",
    "start:http": "node dist/cli.js serve --http",
    "dev": "tsx watch src/index.ts",
    "migrate": "node dist/cli.js migrate",
    "import": "node dist/cli.js import",
    "import:help": "node dist/cli.js import-help",
    "review": "node dist/cli.js review",
    "review:changes": "tsx scripts/review-changes.ts",
    "changes": "tsx scripts/story-changes.ts",
    "test:ranking": "tsx scripts/test-ranking.ts",
    "test:retrieval": "tsx scripts/evaluate-retrieval.ts",
    "test:embeddings": "tsx scripts/test-embeddings.ts",
    "test:http": "tsx scripts/test-http.ts",
    "test:tieline": "npm run build && node --import tsx scripts/test-tieline.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:integration": "tsx scripts/integration.ts",
    "test:import": "tsx scripts/integration-import.ts",
    "test:approval-mode": "tsx scripts/integration-approval-mode.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
