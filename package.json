{
  "name": "tieline",
  "version": "0.1.14",
  "description": "Living Story/AC contract and semantic graph grounded in code, tests, help content, and organizational evidence.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knoxgraeme/tieline.git"
  },
  "homepage": "https://github.com/knoxgraeme/tieline#readme",
  "bugs": {
    "url": "https://github.com/knoxgraeme/tieline/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tieline": "dist/cli.js"
  },
  "files": [
    "dist",
    "migrations",
    "skills",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "tieline": "node dist/cli.js",
    "start": "node dist/cli.js serve",
    "start:http": "node dist/cli.js serve --http",
    "dev": "tsx watch src/index.ts",
    "migrate": "node dist/cli.js migrate",
    "import:help": "node dist/cli.js import-help",
    "test": "npm run test:contract && npm run test:ranking && npm run test:retrieval && npm run test:embeddings && npm run test:http && npm run test:smoke && npm run test:evidence && npm run test:contract-read && npm run test:baseline",
    "test:ranking": "tsx scripts/test-ranking.ts",
    "test:retrieval": "tsx scripts/evaluate-retrieval.ts",
    "test:embeddings": "tsx scripts/test-embeddings.ts",
    "test:http": "tsx scripts/test-http.ts",
    "test:tieline": "npm run build && npm run test:skill-install && node --import tsx scripts/test-tieline.ts",
    "test:skill-install": "tsx scripts/test-skill-install.ts",
    "test:parser-package": "npm run build && tsx scripts/test-parser-package.ts",
    "test:source-snapshot": "tsx scripts/test-source-snapshot.ts",
    "test:code-topology-store": "tsx scripts/test-code-topology-store.ts",
    "test:code-analysis:javascript": "tsx scripts/test-code-analysis-javascript.ts",
    "test:code-analysis:python-rust": "tsx scripts/test-code-analysis-python-rust.ts",
    "test:code-resolution:javascript": "tsx scripts/test-code-resolution-javascript.ts",
    "test:code-resolution:python-rust": "tsx scripts/test-code-resolution-python-rust.ts",
    "test:topology-generation": "tsx scripts/test-topology-generation.ts",
    "test:code-topology": "tsx scripts/test-code-topology.ts",
    "test:code-blast-radius": "tsx scripts/test-code-blast-radius.ts",
    "test:code-topology-command": "tsx scripts/test-code-topology-command.ts",
    "benchmark:parser-runtime": "npm run build && tsx scripts/benchmark-parser-runtime.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:integration": "tsx scripts/integration.ts",
    "test:contract": "tsx scripts/test-contract.ts && tsx scripts/test-manifest.ts && tsx scripts/test-contract-command.ts && tsx scripts/test-contract-context-command.ts && tsx scripts/test-impact.ts && tsx scripts/test-artifact-assurance.ts && tsx scripts/test-intent-context.ts && tsx scripts/test-link-plausibility.ts && tsx scripts/test-reconciliation.ts && tsx scripts/test-path-criteria.ts && tsx scripts/test-grade.ts",
    "test:contract-command": "tsx scripts/test-contract-command.ts",
    "test:contract-context-command": "tsx scripts/test-contract-context-command.ts",
    "test:contract-read": "tsx scripts/test-contract-read.ts",
    "test:impact": "tsx scripts/test-impact.ts",
    "test:artifact-assurance": "tsx scripts/test-artifact-assurance.ts",
    "test:intent-context": "tsx scripts/test-intent-context.ts",
    "test:grade": "tsx scripts/test-grade.ts",
    "test:evidence": "tsx scripts/test-evidence.ts",
    "test:integration:contract-sync": "tsx scripts/integration-contract-sync.ts",
    "test:integration:code-topology": "tsx scripts/integration-code-topology.ts",
    "test:integration:evidence": "tsx scripts/integration-evidence.ts",
    "test:integration:planning": "tsx scripts/integration-planning.ts",
    "test:integration:lifecycle": "tsx scripts/integration-lifecycle.ts",
    "test:baseline": "tsx scripts/test-baseline.ts",
    "test:integration:baseline": "tsx scripts/integration-baseline.ts"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^14.0.3",
    "express": "^4.21.2",
    "picocolors": "^1.1.1",
    "postgres": "^3.4.5",
    "web-tree-sitter": "0.26.12",
    "yaml": "^2.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
